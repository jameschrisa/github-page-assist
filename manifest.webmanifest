{
  "name": "PagePilot — GitHub Pages Deployer",
  "short_name": "PagePilot",
  "description": "Drop a folder, get a live GitHub Pages site. Configures the repo, Pages settings, and site metadata for you.",
  "id": "pagepilot",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#14171c",
  "theme_color": "#14171c",
  "categories": ["developer tools", "productivity", "utilities"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "New deploy",
      "url": "./index.html#deploy",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Site health",
      "url": "./index.html#health",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
